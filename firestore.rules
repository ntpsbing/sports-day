rules_version = '2';
// 楠梓國小 運動會即時通報系統：資料庫安全規則
// 交接時要改的地方：下面兩個函式裡的學校網域與系統管理員帳號（要和 config.js 一致）
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    // 只有教職員：tc 開頭＋數字的學校帳號，或管理員設定過組別的帳號（學生帳號一律擋下）
    function isSchool() { return signedIn() && (email().matches('tc[0-9]+@e1[.]ntps[.]kh[.]edu[.]tw$') || isAdmin() || exists(/databases/$(db)/documents/roles/$(email()))); }
    function isAdmin() { return signedIn() && email() in ['bing5201314@e1.ntps.kh.edu.tw']; }
    // 一個帳號可以兼任多個組別（roles 清單）；沒設定的人是班級導師
    function myRoles() {
      return exists(/databases/$(db)/documents/roles/$(email()))
        ? get(/databases/$(db)/documents/roles/$(email())).data.get('roles', [get(/databases/$(db)/documents/roles/$(email())).data.get('role', 'teacher')])
        : ['teacher'];
    }
    function hasRole(list) { return isAdmin() || (isSchool() && myRoles().hasAny(list)); }
    function staff() { return hasRole(['control','record','sport','checkin','mc','guest','award','live','doc','ceremony','equip','medic','lunch','env','quest','gift','promo','affairs']); }

    // 公開可看（大會看板、看直播）；修改需對應組別
    match /meta/{id}       { allow read: if true; allow write: if hasRole(['record','sport','control','live']); }
    match /events/{id}     { allow read: if true; allow write: if hasRole(['record','sport','checkin']); }
    match /timeline/{id}   { allow read: if true; allow write: if hasRole(['control','record']); }
    match /batches/{id}    { allow read: if true; allow write: if hasRole(['award','control','record','ceremony']); }
    match /guests/{id}     { allow read: if true; allow write: if hasRole(['guest','doc','control','award','record']); }
    match /broadcasts/{id} { allow read: if true; allow write: if staff(); }
    // 學校帳號才能看／填
    match /allrun/{cls}    { allow read, write: if isSchool(); }
    match /logs/{id}       { allow read: if hasRole(['record','control']); allow create: if isSchool(); }
    match /devices/{id}    { allow read: if hasRole(['record','control']); allow write: if isSchool(); }
    match /roles/{e}       { allow read: if isSchool() || (signedIn() && e == email()); allow write: if isAdmin(); }
    match /users/{e}       { allow read: if isAdmin(); allow write: if isSchool() && e == email(); }   // 登入姓名，供管理員對照組別
    match /roster/{id}     { allow read, write: if isAdmin(); }   // 工作分配名單（姓名→組別）
    // 後勤支援
    match /reports/{id}    { allow read, create: if isSchool(); allow update: if isSchool(); }
    match /medical/{id}    { allow read, write: if hasRole(['medic','control','record']); }  // 學生傷病資料：只限醫護組、總控、紀錄組
    match /equip/{id}      { allow read: if isSchool(); allow write: if hasRole(['equip','control','record']); }
    match /lunch/{id}      { allow read: if isSchool(); allow write: if hasRole(['lunch','control','record']); }
    match /gifts/{id}      { allow read: if true; allow write: if hasRole(['gift','control','record']); }
    match /stations/{id}   { allow read: if true; allow write: if hasRole(['quest','control','record']); }
  }
}
